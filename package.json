{
  "name": "ir.aeliux.webq",
  "displayName": "WebQ",
  "version": "1.0.0",
  "description": "A sample Apache Cordova application that responds to the deviceready event.",
  "main": "index.js",
  "scripts": {
    "build": "NODE_ENV=${NODE_ENV:-production} webpack --config webpack.config.js && cordova build android",
    "dev": "NODE_ENV=development npm run build",
    "start": "npm run dev && cordova run android",
    "emulate": "npm run dev && PATH=$ANDROID_HOME/emulator:$PATH cordova emulate android",
    "lint": "eslint --ext .ts,.js src",
    "lint:fix": "eslint --ext .ts,.js src --fix",
    "format": "prettier --write \"src/**/*.{ts,js,css,scss,html,json,md}\""
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Apache Cordova Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "cordova": "^13.0.0",
    "cordova-android": "^15.0.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.8.4",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.1",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "cordova": {
    "platforms": [
      "android"
    ]
  },
  "dependencies": {
    "axios": "^1.18.0",
    "highlight.js": "^11.11.1",
    "html-loader": "^5.1.0",
    "markdown-it": "^14.2.0",
    "material-design-icons": "^3.0.1"
  }
}
