{
  "name": "ir.aeliux.webq",
  "displayName": "WebQ",
  "desktopName": "ir.aeliux.webq.desktop",
  "version": "1.0.0",
  "description": "A suite of simple web apps.",
  "keywords": [
    "ecosystem:capacitor",
    "ecosystem:electron"
  ],
  "author": {
    "name": "Aeliux",
    "email": "itsaeliux@gmail.com",
    "url": "https://github.com/Aeliux"
  },
  "license": "MIT",
  "type": "commonjs",
  "main": "bundle/electron/main/index.js",
  "webq": {
    "shell": {
      "useDarkTheme": true,
      "defaultRoute": "home"
    }
  },
  "scripts": {
    "bundle": "node scripts/webpack-runner.js",
    "bundle:browser": "cross-env WEBQ_TARGET=browser npm run bundle",
    "bundle:electron": "cross-env WEBQ_TARGET=electron npm run bundle webpack.electron.js",
    "bundle:cap": "cross-env WEBQ_TARGET=cap npm run bundle",
    "serve": "cross-env WEBQ_SERVE=1 node scripts/webpack-runner.js",
    "serve:browser": "cross-env WEBQ_TARGET=browser npm run serve",
    "serve:electron": "cross-env WEBQ_TARGET=electron npm run serve",
    "build:browser:dev": "npm run bundle:browser",
    "build:browser:prod": "npm run lint && cross-env NODE_ENV=production npm run bundle:browser",
    "build:cap:dev": "npm run bundle:cap && cap sync && cap build android --flavor development",
    "build:cap:prod": "npm run lint && cross-env NODE_ENV=production npm run bundle:cap && cap sync && cap build android --flavor production",
    "build:electron:dev": "npm run bundle:electron",
    "build:electron:prod": "npm run lint && cross-env NODE_ENV=production npm run bundle:electron",
    "watch:browser": "cross-env WEBQ_WATCH=1 npm run bundle:browser",
    "watch:cap": "cross-env WEBQ_WATCH=1 npm run bundle:cap",
    "watch:electron": "cross-env WEBQ_WATCH=1 npm run bundle:electron",
    "start": "npm run serve:browser",
    "run:cap:dev": "npm run build:cap:dev && cap run android",
    "run:cap:prod": "npm run build:cap:prod && cap run android",
    "run:electron:prod": "npm run build:electron:prod && electron .",
    "run:electron:dev": "npm run build:electron:dev && NODE_ENV=development electron .",
    "dist:browser": "npm run build:browser:prod && rimraf dist/browser && shx mkdir -p dist && shx cp -r bundle/browser dist/browser",
    "dist:cap": "npm run build:cap:prod && shx mkdir -p dist && shx cp android/app/build/outputs/apk/release/app-release.apk dist/android.apk",
    "dist:electron": "npm run build:electron:prod && electron-builder --config electron-builder.config.js && shx rm -rf dist/*-unpacked dist/*.y*ml dist/.icon-ico",
    "dist": "concurrently \"npm run dist:browser\" \"npm run dist:cap\" \"npm run dist:electron\"",
    "lint": "eslint --ext .ts src --max-warnings 0",
    "lint:fix": "eslint --ext .ts src --fix --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,js,css,scss,html,json,md}\"",
    "clean": "npm run clean:staging dist",
    "clean:staging": "rimraf bundle",
    "clean:all": "npm run clean node_modules platforms plugins"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@capacitor/cli": "^8.4.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/electron": "^1.4.38",
    "@types/lodash": "^4.17.24",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "concurrently": "^10.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "cordova-res": "^0.15.4",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "favicons": "^7.3.0",
    "favicons-webpack-plugin": "^6.0.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.6.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.10.2",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.16",
    "postcss-import": "^16.1.1",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.3.2",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "shx": "^0.4.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.1",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.5",
    "webpack-merge": "^6.0.1",
    "workbox-webpack-plugin": "^7.4.1",
    "xml2js": "^0.6.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/device": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/toast": "^8.0.1",
    "async-mutex": "^0.5.0",
    "capacitor-plugin-safe-area": "^5.0.1",
    "core-js": "^3.49.0",
    "lodash": "^4.18.1",
    "material-design-icons": "^3.0.1",
    "material-symbols": "^0.45.4"
  },
  "browserslist": {
    "browser": [
      "last 2 Firefox versions",
      "last 2 Chrome versions",
      "last 2 ChromeAndroid versions",
      "last 2 Safari versions",
      "iOS > 10",
      "last 2 Edge versions",
      "Chrome 27",
      "Chrome 38",
      "Chrome 47",
      "Chrome 53",
      "Chrome 56",
      "Chrome 63",
      "Chrome 71",
      "Edge 18",
      "Firefox ESR"
    ],
    "cap": "chrome >= 60",
    "electron": "electron 42.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "core-js@3.49.0": true,
    "electron-winstaller@5.4.0": true,
    "sharp@0.34.5": true
  }
}
