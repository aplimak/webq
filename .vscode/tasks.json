{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "launch dev server",
      "type": "npm",
      "script": "start",
      "problemMatcher": "$ts-checker-webpack-watch",
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "warn"
      }
    },
    {
      "label": "bundle cordova dev",
      "type": "npm",
      "script": "bundle",
      "group": "build",
      "problemMatcher": [],
      "options": {
        "env": {
          "WEBQ_TARGET": "cordova"
        }
      },
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "build electron dev",
      "type": "npm",
      "script": "build:electron:dev",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
