{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch firefox",
      "type": "firefox",
      "request": "launch",
      "reAttach": true,
      "file": "${workspaceFolder}/bundle/browser/index.html",
      "preLaunchTask": "build browser dev",
      "pathMappings": [
        {
          "url": "webpack://ir.aeliux.webq",
          "path": "${workspaceFolder}"
        }
      ]
    },
    {
      "type": "editor-browser",
      "request": "launch",
      "name": "Launch in integrated browser",
      "url": "file://${workspaceFolder}/bundle/browser/index.html",
      "preLaunchTask": "build browser dev",
      "pathMapping": {
        "webpack://ir.aeliux.webq": "${workspaceFolder}"
      }
    }
  ]
}
